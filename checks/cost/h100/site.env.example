# The H100 host's own settings, kept out of the public repository (Tristan, 2026-09-29: public text
# names the hardware, never the machine). Copy to h100/site.env (gitignored) and fill in; deploy.sh
# and forward-flops.sh copy it to the host with the scripts, and every script in h100/ reads it.
SSH_HOST=<ssh alias of the host with the H100 NVL cards>
REMOTE_ROOT=<the directory on the host that holds the environment, the code and the runs>
GPU_POLICY=<the host's GPU policy script, answering "query" and "pick">
