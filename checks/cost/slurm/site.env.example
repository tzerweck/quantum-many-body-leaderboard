# The cluster's own settings, kept out of the public repository (Tristan, 2026-09-29: public text
# names the hardware, never the cluster). Copy to slurm/site.env (gitignored) and fill in; sync.sh
# copies it to the cluster with the scripts, and every script in slurm/ reads it.
SSH_HOST=<ssh alias of the cluster's login node>
SCRATCH_DIR=<the account's scratch directory on the cluster>
PART_GPU_4H=<GPU partition for jobs up to 4 h>
PART_GPU_24H=<GPU partition for jobs up to 24 h>
PART_CPU_4H=<CPU partition for jobs up to 4 h>
PART_CPU_24H=<CPU partition for jobs up to 24 h>
PART_CPU_120H=<CPU partition for jobs up to 120 h>
GPU_PIN="<the sbatch option that pins an A100 with 80 GB, e.g. a --gres request>"
